# =============================================================================
# PAPERCLIP — ENVIRONMENT VARIABLES REFERENCE
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# =============================================================================

# ==== DOMAINS ====

# Subdomain for the Paperclip UI (used by Traefik router rule)
# Result: https://<PAPERCLIP_SUBDOMAIN>.<DOMAIN_NAME>
PAPERCLIP_SUBDOMAIN=paperclip

# Your root domain (e.g. example.com)
DOMAIN_NAME=example.com

# Internal port the server listens on (default 3100, matches Dockerfile EXPOSE)
PAPERCLIP_PORT=3100

# Full public URL of this Paperclip instance (used for OAuth redirects, webhooks, emails)
# Must match what users see in the browser. Include protocol, no trailing slash.
PAPERCLIP_PUBLIC_URL=https://paperclip.example.com

# Base URL for Better Auth (must match PAPERCLIP_PUBLIC_URL in most setups)
BETTER_AUTH_BASE_URL=https://paperclip.example.com

# PostgreSQL connection string
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://paperclip:yourpassword@your-db-host:5432/paperclip


# ==== API KEYS ====

# OpenAI API key — required for Codex and OpenCode adapters using OpenAI models
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Google Gemini API key — required for the Gemini CLI adapter
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API key — required if using Groq models via OpenCode
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Ollama API key — required for cloud models (gemma4:31b-cloud, qwen3.5:cloud)
# Get one at https://ollama.com — use "ollama" if your instance has no auth
OLLAMA_API_KEY=ollama


# ==== AUTH ====

# Deployment mode:
#   authenticated  — users must sign in (recommended for production)
#   open           — no login required (local dev only)
PAPERCLIP_DEPLOYMENT_MODE=authenticated

# Deployment exposure:
#   private  — invite-only, no public sign-up
#   public   — anyone can register
PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# Secret used by Better Auth to sign session tokens.
# Generate a strong random string: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Master encryption key for Paperclip's secrets store (SSH keys, API key secrets).
# Any non-empty string works — use something long and random.
# If omitted, a key is auto-generated at $PAPERCLIP_HOME/instances/default/secrets/master.key
# and persists across restarts as long as the volume is mounted.
# Generate one: openssl rand -base64 32
PAPERCLIP_SECRETS_MASTER_KEY=replace-with-a-long-random-string


# ==== EMAIL / SMTP (optional) ====

# SMTP server for sending invite emails and OTP verification codes.
# If not set, email sending is skipped silently (invites still work, just no email).
# PAPERCLIP_SMTP_HOST=smtp.example.com
# PAPERCLIP_SMTP_PORT=587
# PAPERCLIP_SMTP_SECURE=false
# PAPERCLIP_SMTP_USER=user@example.com
# PAPERCLIP_SMTP_PASS=yourpassword
# PAPERCLIP_SMTP_FROM=Paperclip <noreply@example.com>


# ==== OPTIONAL ====

# Discord webhook for the daily merge digest script
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Override the UID/GID the server process runs as inside the container
# Defaults to 1000:1000 — set to match your host user to avoid volume permission issues
# USER_UID=1000
# USER_GID=1000
